model User {
    userId    Int     @id @default(autoincrement())
    firstName String?
    lastName  String?

    email String @unique

    defaultCurrencyName String  @default("Canadian Dollar")
    defaultCurrencyCode String  @default("CAD")
    defaultLanguage     String  @default("English")
    password            String?

    regOtp           Int?
    regOTPExpiry     DateTime?
    regOtpVerified   Boolean?  @default(false)
    isProfileCreated Boolean   @default(false)
    profilePic       String?

    accessToken String?
    isGoogle    Boolean @default(false)

    isBlocked Boolean  @default(false)
    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    transactions   Transactions[]
    banks          Bank[]
    bankHistory    BankHistory[]
    income         Income[]
    budget         Budget[]
    budgetLogs     BudgetLog[]
    expense        Expense[]
    netWorth       NetWorthHistory[]
    FinancialItems FinancialItems[]

    @@index([userId])
    @@map("Users")
}
